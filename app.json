{
  "expo": {
    "name": "SpeakNative GH",
    "slug": "app",
    "scheme": "speaknativegh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/logo/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.speaknativegh.app"
    },
    "web": {
      "favicon": "./src/assets/images/logo/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/logo/adaptiveIcon.png",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 200
        }
      ],
      "expo-router",
      "expo-asset",
      "expo-video",
      "expo-audio",
      "expo-secure-store",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "664611e9-fcf1-4a1b-b2a5-07c51a78754d"
      }
    }
  }
}
