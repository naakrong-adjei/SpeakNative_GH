{
  "expo": {
    "name": "SpeakNative GH",
    "slug": "app",
    "scheme": "speaknativegh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/logo/adaptiveIcon.png",
    "userInterfaceStyle": "light",
    "entryPoint": "./node_modules/expo-router/entry",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/logo/adaptiveIcon.png",
        "backgroundColor": "#2E7D32",
        "monochromeImage": "./src/assets/images/logo/adaptiveIcon.png"
      }
    },
    "web": {
      "favicon": "./src/assets/images/logo/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-splash-screen",
      "expo-router",
      "expo-asset",
      "expo-video"
    ]
  }
}
