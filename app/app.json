{
  "expo": {
    "name": "SpeakNative GH",
    "slug": "app",
    "scheme": "speaknativegh",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/logo/adaptiveIcon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./src/assets/images/logo/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2E7D32",
      "dark": {
        "backgroundColor": "#2E7D32"
      }
    },
    "ios": {
      "supportsTablet": true,
      "splash": {
        "image": "./src/assets/images/logo/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#2E7D32"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/logo/adaptiveIcon.png",
        "backgroundColor": "#2E7D32",
        "monochromeImage": "./src/assets/images/logo/adaptiveIcon.png"
      },
      "edgeToEdgeEnabled": true,
      "splash": {
        "image": "./src/assets/images/logo/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#2E7D32"
      }
    },
    "web": {
      "favicon": "./src/assets/images/logo/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/logo/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#2E7D32"
        }
      ]
    ]
  }
}